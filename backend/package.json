{
  "name": "vms-backend",
  "version": "1.0.0",
  "description": "Vendor Management System Backend API",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "seed": "node scripts/seed.js",
    "start": "node server.js",
    "predev": "node scripts/predev.js",
    "dev": "node --watch --watch-path=server.js --watch-path=app.js --watch-path=controllers --watch-path=models --watch-path=routes --watch-path=services --watch-path=middleware --watch-path=config --watch-path=utils --watch-path=events server.js",
    "predev:api": "node scripts/predev.js",
    "dev:api": "node --watch --watch-path=server.js --watch-path=app.js --watch-path=controllers --watch-path=models --watch-path=routes --watch-path=services --watch-path=middleware --watch-path=config --watch-path=utils --watch-path=events server.js",
    "dev:worker": "node worker.js",
    "clean:port": "node ../scripts/free_port.js 5000",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "jest tests/e2e_erp_workflow.test.js",
    "test:all": "jest tests/unit tests/integration tests/e2e_erp_workflow.test.js",
    "pretest": "cross-env NODE_ENV=test node scripts/setup_test_db.js",
    "start:test": "cross-env NODE_ENV=test node server.js",
    "test": "cross-env NODE_ENV=test start-server-and-test start:test http://localhost:5000/api/health test:all"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.6",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.3.2",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^6.0.0",
    "ioredis-mock": "^8.13.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.3.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.15.0",
    "rate-limit-redis": "^6.0.1",
    "socket.io": "^4.8.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "kill-port": "^2.0.1",
    "mongodb-memory-server": "^11.2.0",
    "start-server-and-test": "^3.0.12",
    "supertest": "^7.2.2"
  }
}
