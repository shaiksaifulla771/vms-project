{
  "name": "vms-backend",
  "version": "1.0.0",
  "description": "Vendor Management System Backend API",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "seed": "node scripts/seed.js",
    "start": "node server.js",
    "dev": "node server.js",
    "dev:api": "node server.js",
    "dev:worker": "node worker.js",
    "test:integration": "node scripts/security_verification_pass.js && node scripts/test_nosql_typecheck_fix.js && node scripts/test_sequence_peek_fix.js && node scripts/test_mpn_requirements.js && node scripts/verify_bom_phase1.js && node scripts/test_bom_output_quantity_rollup.js && node scripts/verify_vendor_sequence_fix.js && node scripts/test_rate_limits.js && jest",
    "pretest": "cross-env NODE_ENV=test node scripts/setup_test_db.js",
    "start:test": "cross-env NODE_ENV=test node server.js",
    "test": "cross-env NODE_ENV=test start-server-and-test start:test http://localhost:5000/api/health test:integration"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "ioredis-mock": "^8.13.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "multer": "^2.2.0",
    "pdfkit": "^0.15.0",
    "rate-limit-redis": "^6.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "start-server-and-test": "^3.0.12",
    "supertest": "^7.2.2"
  }
}
