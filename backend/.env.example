# VMS Environment Configuration Example
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/vms
JWT_SECRET=super-secret-key-32-chars-long-12345
CLIENT_URL=http://localhost:3000

# Email Management Service Configuration
EMAIL_PROVIDER=console
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@vms-system.com

# MCP Integration Configuration
MCP_SERVER_URL=http://localhost:5000/api/mcp
MCP_AUTH_TOKEN=super-secret-mcp-token-12345
