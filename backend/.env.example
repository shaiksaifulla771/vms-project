# VMS Environment Configuration — REQUIRED VARIABLES
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git. See .gitignore.

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/vms

# ─────────────────────────────────────────────────────────────────────────────
# JWT SECURITY — Generate strong secret with:
#   node -e "require('crypto').randomBytes(48).toString('hex')"
# Minimum 32 characters required. Server crashes on startup if missing.
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
SESSION_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
LEGACY_JWT_AUTH_ENABLED=false

# Frontend URL (comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL SERVICE — Brevo (SendInBlue) or SMTP
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console
BREVO_API_KEY=REPLACE_WITH_YOUR_BREVO_API_KEY
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME="VMS System"
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# MCP Integration — Generate token with:
#   node -e "require('crypto').randomBytes(32).toString('hex')"
# ─────────────────────────────────────────────────────────────────────────────
MCP_SERVER_URL=http://localhost:5000/api/mcp
MCP_AUTH_TOKEN=REPLACE_WITH_STRONG_RANDOM_TOKEN

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Admin SDK — Backend ONLY — NEVER expose to frontend or git
# Download service account JSON from Firebase Console > Settings > Service Accounts
# Then run: node scripts/setup_firebase_credentials.js
# ─────────────────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXXX@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────────────────────────────────────────────
# Security Flags (Production)
# ─────────────────────────────────────────────────────────────────────────────
# Set TRUST_PROXY=true when behind nginx/load balancer
TRUST_PROXY=false
# Set FORCE_HTTPS=true to redirect HTTP → HTTPS in production
FORCE_HTTPS=false
