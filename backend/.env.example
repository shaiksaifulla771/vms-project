# DATABASE_URL must authenticate as Supabase's `authenticated` role, never
# `service_role` or a superuser. RLS is only meaningful when normal request
# handling runs through a connection RLS applies to.
#
# Supabase gives you the pooled URI in Project Settings -> Database ->
# Connection string. Prefer the "Transaction" pooler (port 6543) for
# stateless FastAPI workers; use "Session" (5432) for local dev.
DATABASE_URL=postgresql+asyncpg://authenticated:<password>@<host>:6543/postgres

# Used to build the JWKS URL: {SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://<project-ref>.supabase.co

# Only needed if your project is still on the legacy shared HS256 secret
# (no asymmetric signing keys published). New projects can leave it unset.
# SUPABASE_JWT_SECRET=

JWT_ALGORITHM=HS256
JWT_AUDIENCE=authenticated

# Per-request Postgres timeouts (milliseconds). See app/core/db.py.
LOCK_TIMEOUT_MS=5000
STATEMENT_TIMEOUT_MS=30000

# Comma-separated CORS origins for the frontend (empty = wildcard for dev)
CORS_ORIGINS=http://localhost:5173
