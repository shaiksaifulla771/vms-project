# ---------------------------------------------------------------------------
# ERP backend configuration (copy to backend/.env)
# ---------------------------------------------------------------------------

# PostgreSQL connection. For Supabase use the connection string from
#   Project Settings -> Database -> Connection string (URI), e.g. Session pooler:
#   postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# NEVER commit the real value.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/erp_dev

# SSL is turned on automatically for *.supabase.com / *.supabase.co hosts
# DATABASE_SSL=true
DATABASE_POOL_MAX=10

PORT=5000

# Frontend origin(s) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:3000

# Apply pending db/migrations/*.sql on start (set false to manage migrations manually)
AUTO_MIGRATE=true

# Tests use a separate throw-away database (it is wiped on every test run)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/erp_test
