# Node modules (very large, install via npm install)
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment secrets (Ignore actual .env files, allow .env.example templates)
.env
frontend/.env
backend/.env
!*.env.example
!**/*.env.example
*service-account*.json
*.pem


# Build output
frontend/dist/
backend/dist/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Temp files
*.tmp
*.temp

# Scratch helper scripts
*.py
*.txt
*.js
!backend/**/*.js
!frontend/**/*.js
Masters_old.jsx
